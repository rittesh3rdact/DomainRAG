# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Shapes the system prompt's role/persona. Update this if you change what's
# in data/ -- it's the only place the domain is named in plain English.
ASSISTANT_ROLE_DESCRIPTION="a knowledgeable assistant across three specific domains: personal finance, Indian law, and pickleball rules and strategy. You don't cover other topics."

# Optional overrides (defaults shown)
EMBEDDING_MODEL=models/gemini-embedding-001

# If the primary model fails (quota exhausted, overloaded, retired), these
# are tried in order automatically.
GENERATION_MODEL=gemini-flash-latest
GENERATION_MODEL_FALLBACKS=gemini-2.5-flash,gemini-2.5-pro
UTILITY_MODEL=gemini-flash-lite-latest
UTILITY_MODEL_FALLBACKS=gemini-2.5-flash-lite,gemini-2.5-flash

CHUNK_SIZE=1000
CHUNK_OVERLAP=150

VECTOR_CANDIDATES=15
BM25_CANDIDATES=15
RERANK_CANDIDATES=10
TOP_K=5
SIMILARITY_THRESHOLD=0.35

ENABLE_CONTEXTUAL_RETRIEVAL=true
ENABLE_HYBRID_SEARCH=true
ENABLE_RERANKING=true
MAX_TOOL_CALLS=3

# Proactive requests-per-minute pacing per model (see README "free-tier
# limits" section). Lower these if you still see 429s; raise them if your
# quota tier allows more.
EMBEDDING_MODEL_RPM=10
UTILITY_MODEL_RPM=10
GENERATION_MODEL_RPM=10

# Requests /api/chat itself accepts per minute, across all clients --
# rejected immediately (429) rather than queued, to protect daily quota.
CHAT_REQUESTS_PER_MINUTE=10

CHROMA_DIR=./chroma_db
COLLECTION_NAME=domain_docs
BM25_INDEX_PATH=./chroma_db/bm25_index.pkl
DATA_DIR=./data
